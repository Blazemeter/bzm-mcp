op/bzm-mcp-macos-arm64 --version</pre>
</div>
</div></li>
</ol>
<p local-id=3D"d6d77f79-300e-4e5b-b864-dc2d25fc63a4"><strong>For DMG files:=
</strong></p>
<ol start=3D"1" local-id=3D"78552fff-475b-4ce6-944d-10587193e8f5">
<li local-id=3D"5b8649b7-7f31-495f-b92e-6b083a070f42">
<p local-id=3D"e24cd7d6-df26-4b01-bd11-a3bddb540762"><strong>Mount the DMG:=
